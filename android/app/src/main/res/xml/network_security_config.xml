<?xml version="1.0" encoding="utf-8"?>
<!--
  Direct URL playback (P4-01/P4-02, URL-004).

  `validateDirectUrl` accepts plain `http://` so local-network / self-hosted
  streams (e.g. http://192.168.1.10:8080/video.mp4) keep working — the
  documented SEC-006 exception. Android denies cleartext by default from API
  28 unless the app opts in, which made those entries unplayable: the
  dart:io probe (own socket stack) reported them as available while the
  player engine's platform HTTP stack refused them with
  "Cleartext HTTP traffic to <host> not permitted".

  Permit cleartext so the two agree. The engine still only reaches hosts the
  user explicitly added, and HTTPS stays preferred everywhere it is offered.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
